DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
JWT_SECRET="replace-with-a-long-random-secret"
CORS_ORIGIN="https://your-frontend-domain.com"
PORT=3000
REQUEST_BODY_LIMIT="50mb"
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_WINDOW_MS=3600000
LOGIN_RATE_LIMIT_MAX=10
AUTH_COOKIE_NAME="ecopuce_token"
AUTH_COOKIE_SAMESITE="none"
AUTH_COOKIE_SECURE=true
AUTH_RETURN_TOKEN=false
CLOUDINARY_UPLOAD_ENABLED=false

SEED_ADMIN_EMAIL="admin.demo@puce.edu.ec"
SEED_ADMIN_PASSWORD="replace-with-a-local-admin-password"
SEED_STUDENT_EMAIL="student.demo@puce.edu.ec"
SEED_STUDENT_PASSWORD="replace-with-a-local-student-password"
SEED_TEACHER_EMAIL="teacher.demo@puce.edu.ec"
SEED_TEACHER_PASSWORD="replace-with-a-local-teacher-password"
